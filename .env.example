# Prohori environment template.
#
# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. No secret values appear in this template.
#
#   cp .env.example .env     # then edit .env
#
# Every variable below is read by the backend (app/config.py). Required values
# have no default: the backend refuses to start if any is missing or blank.

# --- Required ---------------------------------------------------------------

# Async SQLAlchemy connection URL for PostgreSQL 16 + pgvector.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# For docker-compose this is the compose "db" service.
DATABASE_URL=postgresql+asyncpg://prohori:prohori@db:5432/prohori

# Claude API key (Haiku 5.5 and Sonnet 5.5 via the anthropic SDK).
ANTHROPIC_API_KEY=

# Secret key used to HMAC phone numbers before storage. Must be long and random.
# Rotating this orphans every existing number hash, so choose it once per deploy.
NUMBER_HMAC_KEY=

# Secret used to sign/seal session and guest cookies. Long random string.
SESSION_SECRET=

# --- Optional (safe defaults; leave blank to use the default) ---------------

# Voyage embeddings key (voyage-4). Blank -> retrieval falls back to keyword-only.
VOYAGE_API_KEY=

# Resend transactional email key. Only needed when EMAIL_DRIVER=resend.
RESEND_API_KEY=

# Email driver: "console" prints verification/reset links to the server log (dev),
# "resend" sends real email. Default: console.
EMAIL_DRIVER=console

# Public origin of the frontend, used for exact-match CORS. Default: Vite dev URL.
APP_ORIGIN=http://localhost:5173

# Sentry DSN for error monitoring. Blank -> monitoring disabled.
SENTRY_DSN=

# Hard daily ceiling on Claude spend (USD). The pipeline stops calling the model
# once the day's estimated spend crosses this. Default: 5.0
DAILY_LLM_SPEND_CAP_USD=5.0

# Environment: development | test | production. Outside development/test the
# session cookie is __Host-prohori_session with Secure set. Default: development
ENVIRONMENT=development

# Trust X-Forwarded-For for the client IP (login lock and rate limits). Set true
# ONLY behind a reverse proxy that overwrites that header; otherwise clients can
# spoof their IP. Default: false
TRUST_PROXY_HEADERS=false

# --- Seed demo-user passwords (scripts/seed.py only) ------------------------
#
# Passwords for the three pre-verified demo accounts the seed creates
# (user@prohori.test, reviewer@prohori.test, admin@prohori.test). The seed reads
# these from the environment and never hard-codes them; each must be 10+ chars
# and not on the common-password blocklist (app/security/passwords.py), or the
# seed refuses to run. Leave blank here; set real values in your local .env.
SEED_USER_PASSWORD=
SEED_REVIEWER_PASSWORD=
SEED_ADMIN_PASSWORD=
